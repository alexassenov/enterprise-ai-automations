        "jsCode": "const row = $json || {};\n    const now = new Date();\n    const datePart = now.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);\n    const randomPart = Math.random().toString(36).slice(2, 6).toUpperCase();\n    const caseId = \"LC-\" + datePart + \"-\" + randomPart;\n\n    // \u041d\u043e\u0440\u043c\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043c\u0435 \u0438\u043c\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043a\u043e\u043b\u043e\u043d\u0438\u0442\u0435 (\u043c\u0430\u0445\u0430\u043c\u0435 \u0438\u0437\u043b\u0438\u0448\u043d\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0438)\n    const normalizedRow = {};\n    for (const key in row) {\n      normalizedRow[key.trim()] = row[key];\n    }\n\n    // \u0412\u0437\u0438\u043c\u0430\u043c\u0435 \u043b\u0438\u043d\u043a\u0430 \u043e\u0442 \u043a\u043e\u043b\u043e\u043d\u0430\u0442\u0430 (\u0432\u0435\u0447\u0435 \u0438\u0437\u0447\u0438\u0441\u0442\u0435\u043d\u0430 \u043e\u0442 \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b\u0438)\n    const fileLink = normalizedRow['Upload LC PDF'] || '';\n\n    // \u0418\u0437\u0432\u043b\u0438\u0447\u0430\u043c\u0435 Google Drive ID-\u0442\u043e \u043e\u0442 \u043b\u0438\u043d\u043a\u0430\n    let driveFileId = '';\n    const match = fileLink.match(/[-\\w]{25,}/);\n    if (match) driveFileId = match[0];\n\n    return [{\n      json: {\n        caseId,\n        submitterName: normalizedRow['Full Name'] || '',\n        company: normalizedRow['Company'] || '',\n        email: normalizedRow['Business Email'] || '',\n        buyerCountry: normalizedRow['Buyer Country'] || '',\n        lcValue: normalizedRow['Letter of Credit Value'] || '',\n        description: normalizedRow['Brief Description of Goods'] || '',\n        fileLink,\n        driveFileId,\n        originalRow: row\n      }\n    }];\n\n"
      },
