      "parameters": {
        "jsCode": "var inputData = $input.first().json;\n\nfunction findArray(obj, possibleKeys) {\n  if (obj && typeof obj === 'object') {\n    for (var i = 0; i < possibleKeys.length; i++) {\n      if (obj[possibleKeys[i]] && Array.isArray(obj[possibleKeys[i]])) {\n        return obj[possibleKeys[i]];\n      }\n    }\n    for (var k in obj) {\n      if (typeof obj[k] === 'object') {\n        var res = findArray(obj[k], possibleKeys);\n        if (res) return res;\n      }\n    }\n  }\n  return null;\n}\n\nfunction findSummary(obj) {\n  if (obj && obj.summary) return obj.summary;\n  if (obj && obj.Summary) return obj.Summary;\n  if (obj && typeof obj === 'object') {\n    for (var k in obj) {\n      if (typeof obj[k] === 'object') {\n        var res = findSummary(obj[k]);\n        if (res) return res;\n      }\n    }\n  }\n  return null;\n}\n\nvar parsedData = {};\n\n// \u0422\u044a\u0440\u0441\u0438\u043c \u043d\u0430\u0432\u0441\u044f\u043a\u044a\u0434\u0435 \u0437\u0430 \u0442\u0435\u043a\u0441\u0442, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u0438\u043b\u0438\u0447\u0430 \u043d\u0430 JSON\nfor (var key in inputData) {\n  var rawText = inputData[key];\n  if (typeof rawText === 'string' && (rawText.includes('red_flags') || rawText.includes('redFlags'))) {\n    rawText = rawText.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n    try { \n      parsedData = JSON.parse(rawText); \n      break; \n    } catch (e) {}\n  } else if (typeof rawText === 'object' && rawText !== null) {\n    if (rawText['red_flags'] || rawText['redFlags']) {\n      parsedData = rawText;\n      break;\n    }\n  }\n}\n\nvar redFlagsArray = findArray(parsedData, ['red_flags', 'redFlags']) || findArray(inputData, ['red_flags', 'redFlags']) || [];\nvar watchItemsArray = findArray(parsedData, ['watch_items', 'watchItems']) || findArray(inputData, ['watch_items', 'watchItems']) || [];\nvar summaryObj = findSummary(parsedData) || findSummary(inputData);\n\nvar allIssues = redFlagsArray.concat(watchItemsArray);\nvar outputVars = {};\n\n// 1. \u0413\u0415\u041d\u0415\u0420\u0418\u0420\u0410\u041d\u0415 \u041d\u0410 \u041f\u042a\u041b\u041d\u0410 HTML \u0422\u0410\u0411\u041b\u0418\u0426\u0410 \u0417\u0410 \u0418\u041c\u0415\u0419\u041b\u0410\nvar htmlTable = \"<table border=\\\"1\\\" cellpadding=\\\"8\\\" style=\\\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif;\\\">\";\nhtmlTable += \"<tr style=\\\"background-color:#f2f2f2; text-align: left;\\\"><th>#</th><th>LC Field / Clause</th><th>Trap Type</th><th>Rating</th><th>Max Exposure</th><th>Plain-language meaning</th></tr>\";\n\nfor (var k = 0; k < allIssues.length; k++) {\n  var emIssue = allIssues[k];\n  var emRating = emIssue.rating || emIssue.Rating || (k < redFlagsArray.length ? \"RED FLAG\" : \"WATCH\");\n  var emColor = (emRating.toUpperCase().indexOf(\"RED\") !== -1) ? \"red\" : \"#f0ad4e\";\n  var emDesc = (emIssue.why_it_hurts || emIssue.whyItHurts || \"\") + \"<br><br><b>Revised wording:</b><br>\" + (emIssue.revised_wording || emIssue.revisedWording || \"\");\n  \n  htmlTable += \"<tr>\";\n  htmlTable += \"<td>\" + (k + 1) + \"</td>\";\n  htmlTable += \"<td><b>\" + (emIssue.clause || emIssue.Clause || \"\") + \"</b></td>\";\n  htmlTable += \"<td>\" + (emIssue.trap_type || emIssue.trapType || \"\") + \"</td>\";\n  htmlTable += \"<td style=\\\"color:\" + emColor + \"; font-weight:bold;\\\">\" + emRating + \"</td>\";\n  htmlTable += \"<td><b>\" + (emIssue.exposure || emIssue.Exposure || \"\") + \"</b></td>\";\n  htmlTable += \"<td>\" + emDesc + \"</td>\";\n  htmlTable += \"</tr>\";\n}\nhtmlTable += \"</table>\";\n\nif (summaryObj) {\n  var rC = summaryObj.red_flags_count || summaryObj.redFlagsCount || 0;\n  var wC = summaryObj.watch_items_count || summaryObj.watchItemsCount || 0;\n  var tE = summaryObj.total_exposure || summaryObj.totalExposure || \"\";\n  \n  htmlTable += \"<br><div style=\\\"font-family: Arial, sans-serif;\\\">\";\n  htmlTable += \"<p><b>Red Flags: \" + rC + \"</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <b>Watch: \" + wC + \"</b><br>\";\n  htmlTable += rC + \" fatal traps, \" + wC + \" warning signals</p>\";\n  htmlTable += \"<p><b>Worst-case exposure</b><br><span style=\\\"font-size:18px; color:red;\\\">\" + tE + \"</span></p>\";\n  htmlTable += \"</div>\";\n}\noutputVars[\"htmlTable\"] = htmlTable;\n\n// 2. \u0418\u0417\u0427\u0418\u0421\u0422\u0415\u041d \u0414\u0418\u0417\u0410\u0419\u041d \u0417\u0410 GOOGLE DOCS (PDF-\u0430) - \u0411\u0415\u0417 \u0422\u0415\u0416\u041a\u0418 \u0421\u0418\u041c\u0412\u041e\u041b\u0418\nvar cardText = \"\\n\";\n\nfor (var i = 0; i < allIssues.length; i++) {\n  var issue = allIssues[i];\n  var rating = issue.rating || issue.Rating || (i < redFlagsArray.length ? \"RED FLAG\" : \"WATCH\");\n  var ratingClean = rating.toUpperCase().indexOf(\"RED\") !== -1 ? \"\ud83d\udd34 RED FLAG\" : \"\ud83d\udfe1 WATCH\";\n  \n  cardText += \"ISSUE #\" + (i + 1) + \": \" + (issue.clause || issue.Clause || \"\") + \"\\n\";\n  cardText += \"--------------------------------------------------\\n\";\n  cardText += \"Type:       \" + (issue.trap_type || issue.trapType || \"\") + \"\\n\";\n  cardText += \"Rating:     \" + ratingClean + \"\\n\";\n  cardText += \"Exposure:   \" + (issue.exposure || issue.Exposure || \"\") + \"\\n\\n\";\n  cardText += \"Plain-language meaning:\\n\" + (issue.why_it_hurts || issue.whyItHurts || \"\") + \"\\n\\n\";\n  cardText += \"Revised wording:\\n\" + (issue.revised_wording || issue.revisedWording || \"\") + \"\\n\\n\";\n  cardText += \"--------------------------------------------------\\n\\n\\n\";\n}\n\nif (summaryObj) {\n  var rCount = summaryObj.red_flags_count || summaryObj.redFlagsCount || 0;\n  var wCount = summaryObj.watch_items_count || summaryObj.watchItemsCount || 0;\n  var tExp = summaryObj.total_exposure || summaryObj.totalExposure || \"\";\n  \n  cardText += \"REPORT SUMMARY\\n\";\n  cardText += \"--------------------------------------------------\\n\";\n  cardText += \"Red Flags: \" + rCount + \"        Watch Items: \" + wCount + \"\\n\";\n  cardText += rCount + \" fatal traps, \" + wCount + \" warning signals\\n\\n\";\n  cardText += \"Worst-case exposure:\\n\";\n  cardText += tExp + \"\\n\";\n}\n\noutputVars[\"formattedText\"] = cardText;\n\nreturn [{ json: outputVars }];\n"
      },
