  "versionCounter": 2,
  "sourceWorkflowId": null,
  "triggerCount": 1,
  "nodes": [
    {
      "id": "webhook-send-whatsapp",
      "name": "Webhook WhatsApp Trigger",
      "webhookId": "4edf07ca-5a16-4c4f-9f83-0388e0aee9ac",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "kalimera-send-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "clean-phone",
      "name": "Format Phone & Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body || $input.first().json;\nconst rawPhone = body.phone || body.number || '';\nconst cleanPhone = rawPhone.replace(/[^0-9]/g, '');\nconst message = body.message || body.text || 'Γεια σας!';\nconst leadId = body.id || '';\n\nreturn [{\n  json: {\n    leadId: leadId,\n    phone: cleanPhone,\n    message: message\n  }\n}];\n"
      }
    },
    {
      "id": "evolution-send",
      "name": "WhatsApp Gateway (Baileys)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:8085/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.phone }}\",\n  \"text\": \"{{ $json.message }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "respond-webhook",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"channel\": \"whatsapp\",\n  \"gateway\": \"Evolution API v2\"\n}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook WhatsApp Trigger": {
      "main": [
        [
          {
            "node": "Format Phone & Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
