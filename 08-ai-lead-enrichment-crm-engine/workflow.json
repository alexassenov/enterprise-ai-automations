    {
      "parameters": {
        "jsCode": "// 1. \u0412\u0437\u0438\u043c\u0430\u043c\u0435 HTML \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435\u0442\u043e \u043e\u0442 HTTP Request Scraper \u043d\u043e\u0434\u0430\nconst htmlContent = $input.first().json.data || $input.first().json.body || '';\n\n// 2. \u041f\u043e\u0447\u0438\u0441\u0442\u0432\u0430\u043c\u0435 HTML \u0442\u0430\u0433\u043e\u0432\u0435\u0442\u0435, \u0437\u0430 \u0434\u0430 \u043e\u0441\u0442\u0430\u043d\u0435 \u0441\u0430\u043c\u043e \u0447\u0438\u0441\u0442 \u0442\u0435\u043a\u0441\u0442 \u0437\u0430 AI\nconst cleanText = htmlContent\n  .toString()\n  .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n  .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\n// 3. \u0412\u0437\u0438\u043c\u0430\u043c\u0435 \u0442\u043e\u0447\u043d\u0438\u0442\u0435 3 \u043f\u043e\u043b\u0435\u0442\u0430, \u0438\u0437\u043f\u0440\u0430\u0442\u0435\u043d\u0438 \u043e\u0442 \u0442\u0432\u043e\u044f\u0442\u0430 \u0444\u043e\u0440\u043c\u0430\nconst webhookData = $('Webhook Trigger').first().json.body;\n\nreturn {\n  json: {\n    client_name: webhookData.name || 'Client',\n    bottleneck_goal: webhookData.bottleneck || 'No bottleneck specified',\n    contact_info: webhookData.email || 'No contact provided',\n    website_url: webhookData.website_url || 'https://lexmation.com',\n    scraped_text: cleanText\n  }\n};"
      },
