    {
      "parameters": {
        "jsCode": "const rawText = $('Format Lead Output').first().json.output || $('Google Sheets Log').first().json.output || '';\nconst clientName = $('Format Lead Output').first().json.client_name || '\u041d\u044f\u043c\u0430 \u043f\u043e\u0441\u043e\u0447\u0435\u043d\u043e \u0438\u043c\u0435';\nconst contactInfo = $('Format Lead Output').first().json.contact_info || '\u041d\u044f\u043c\u0430 \u043f\u043e\u0441\u043e\u0447\u0435\u043d \u043a\u043e\u043d\u0442\u0430\u043a\u0442';\nconst bottleneckGoal = $('Format Lead Output').first().json.bottleneck_goal || '\u041d\u044f\u043c\u0430 \u043f\u043e\u0441\u043e\u0447\u0435\u043d\u0430 \u0446\u0435\u043b';\n\nlet emailSubject = '\u0418\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u043d\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 - Lexmation';\nlet emailBody = rawText;\n\n// 1. \u0418\u0437\u0432\u043b\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u0442\u0435\u043c\u0430 (Subject)\nconst subjectMatch = rawText.match(/(?:\\*\\*|)?(?:\u0422\u0435\u043c\u0430|Subject)(?:\\*\\*|)?:\\s*(.*)/i);\nif (subjectMatch && subjectMatch[1]) {\n  emailSubject = subjectMatch[1].replace(/[\\*\\_]/g, '').trim();\n}\n\n// 2. \u0418\u0437\u0432\u043b\u0438\u0447\u0430\u043d\u0435 \u043d\u0430 \u0441\u044a\u0449\u0438\u043d\u0441\u043a\u0438\u044f \u043f\u0438\u0442\u0447 \u0437\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (\u043e\u0442 \"\u0417\u0434\u0440\u0430\u0432\u0435\u0439\u0442\u0435 / Hi\" \u043d\u0430\u0442\u0430\u0442\u044a\u043a)\nconst greetingMatch = rawText.match(/(\u0417\u0434\u0440\u0430\u0432\u0435\u0439\u0442\u0435|\u0417\u0434\u0440\u0430\u0432\u0435\u0439|Hi|Hello)[\\s\\,\\!]/i);\nif (greetingMatch) {\n  emailBody = rawText.substring(rawText.indexOf(greetingMatch[0])).trim();\n}\n\n// 3. \u041e\u0442\u0440\u044f\u0437\u0432\u0430\u043c\u0435 \u043c\u0435\u0442\u0430-\u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u043e\u0442\u0434\u043e\u043b\u0443\nconst cutoffMatch = emailBody.match(/(?:\\*\\*\\*|\u0410\u043d\u0430\u043b\u0438\u0437 \u043d\u0430 \u043f\u043e\u0434\u0445\u043e\u0434\u0430|Why this pitch works|Analysis of the Inquiry)/i);\nif (cutoffMatch) {\n  emailBody = emailBody.substring(0, cutoffMatch.index).trim();\n}\n\n// 4. \u041a\u0440\u0430\u0442\u044a\u043a \u043f\u0440\u0435\u0433\u043b\u0435\u0434 \u0437\u0430 Slack (\u0434\u043e 500 \u0441\u0438\u043c\u0432\u043e\u043b\u0430)\nlet slackPreview = emailBody;\nif (slackPreview.length > 500) {\n  slackPreview = slackPreview.substring(0, 497) + '...';\n}\n\n// 5. \u0411\u043e\u0433\u0430\u0442 HTML \u0430\u043d\u0430\u043b\u0438\u0437 \u0437\u0430 \u0442\u0432\u043e\u044f \u0432\u044a\u0442\u0440\u0435\u0448\u0435\u043d \u0438\u043c\u0435\u0439\u043b\nconst adminHtmlBody = `\n<div style=\"font-family: Arial, sans-serif; background-color: #0f172a; color: #ffffff; padding: 25px; border-radius: 12px; max-width: 650px;\">\n  <h2 style=\"color: #ec4899; margin-top: 0;\">\ud83d\ude80 \u041d\u043e\u0432 Lead \u0432 Lexmation</h2>\n  <hr style=\"border: 0.5px solid rgba(255,255,255,0.1); margin-bottom: 20px;\">\n  \n  <div style=\"background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; margin-bottom: 20px;\">\n    <p style=\"margin: 5px 0;\"><strong>\ud83d\udc64 \u0418\u043c\u0435 / \u0411\u0440\u0430\u043d\u0434:</strong> ${clientName}</p>\n    <p style=\"margin: 5px 0;\"><strong>\u2709\ufe0f \u041a\u043e\u043d\u0442\u0430\u043a\u0442:</strong> ${contactInfo}</p>\n    <p style=\"margin: 5px 0;\"><strong>\ud83c\udfaf \u0417\u0430\u044f\u0432\u0435\u043d\u0430 \u0446\u0435\u043b / \u041f\u0440\u043e\u0431\u043b\u0435\u043c:</strong> ${bottleneckGoal}</p>\n  </div>\n\n  <h3 style=\"color: #38bdf8; margin-bottom: 10px;\">\ud83d\udcca \u041f\u044a\u043b\u0435\u043d AI \u0410\u043d\u0430\u043b\u0438\u0437 \u0438 \u041f\u043b\u0430\u043d:</h3>\n  <div style=\"background: rgba(56, 189, 248, 0.1); padding: 15px; border-radius: 8px; border: 1px solid rgba(56, 189, 248, 0.2); white-space: pre-wrap; font-size: 14px; line-height: 1.6; color: #cbd5e1;\">${rawText}</div>\n</div>\n`;\n\nreturn {\n  json: {\n    client_name: clientName,\n    contact_info: contactInfo,\n    bottleneck_goal: bottleneckGoal,\n    client_email_subject: emailSubject,\n    client_email_body: emailBody,\n    admin_html_body: adminHtmlBody,\n    slack_preview: slackPreview\n  }\n};\n"
      },
