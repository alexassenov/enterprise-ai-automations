    {
      "id": "c4946a2d-ba70-44df-abfa-3ab5042d899f",
      "name": "Parse Structured JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet raw = '';\nif (item.content?.[0]?.text) {\n  raw = item.content[0].text;\n} else if (Array.isArray(item) && item[0]?.content?.[0]?.text) {\n  raw = item[0].content[0].text;\n} else if (item.output?.[0]?.content?.[0]?.text) {\n  raw = item.output[0].content[0].text;\n} else if (typeof item.output === 'string') {\n  raw = item.output;\n} else if (typeof item.text === 'string') {\n  raw = item.text;\n} else {\n  raw = JSON.stringify(item);\n}\n\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nif (match) raw = match[0];\n\ntry {\n  let parsed = JSON.parse(raw);\n  if (parsed.content?.[0]?.text) {\n    let inner = parsed.content[0].text.replace(/```json/gi, '').replace(/```/g, '').trim();\n    const innerMatch = inner.match(/\\{[\\s\\S]*\\}/);\n    if (innerMatch) inner = innerMatch[0];\n    parsed = JSON.parse(inner);\n  }\n\n  return [{\n    json: {\n      Date_Time: parsed.Date_Time || parsed.date_time || new Date().toISOString().replace('T', ' ').substring(0, 19),\n      Ticker: parsed.Ticker || parsed.ticker || 'NBIS',\n      Verdict: parsed.Verdict || parsed.verdict || 'WATCH',\n      Confidence: parsed.Confidence || parsed.confidence || '0%',\n      Current_Price: parsed.Current_Price || parsed.current_price || '0',\n      RVOL: parsed.RVOL || parsed.rvol || '1.0x',\n      Market_Trend: parsed.Market_Trend || parsed.market_trend || 'Neutral',\n      Entry_Trigger: parsed.Entry_Trigger || parsed.entry_trigger || '',\n      Stop_Loss: parsed.Stop_Loss || parsed.stop_loss || '0',\n      Target_Price: parsed.Target_Price || parsed.target_price || '0',\n      Risk_Reward: parsed.Risk_Reward || parsed.risk_reward || '',\n      Catalyst_Headline: parsed.Catalyst_Headline || parsed.catalyst_headline || '',\n      Telegram_Report: raw,\n      Outcome: parsed.Outcome || parsed.outcome || 'Pending',\n      Realized_PnL: ''\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      Date_Time: new Date().toISOString().replace('T', ' ').substring(0, 19),\n      Ticker: 'NBIS',\n      Verdict: 'PARSE_ERROR',\n      Confidence: '0%',\n      Current_Price: '0',\n      RVOL: '0x',\n      Market_Trend: 'Error',\n      Entry_Trigger: '',\n      Stop_Loss: '0',\n      Target_Price: '0',\n      Risk_Reward: '',\n      Catalyst_Headline: '',\n      Telegram_Report: raw,\n      Outcome: 'ERROR',\n      Realized_PnL: ''\n    }\n  }];\n}"
      }
    },
